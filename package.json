{
    "name": "@postalsys/email-ai-tools",
    "version": "2.2.8",
    "description": "Summarize and risk-score email messages with an OpenAI-compatible chat model",
    "main": "index.js",
    "scripts": {
        "test": "node --test test/*.test.js",
        "test:coverage": "c8 npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/email-ai-tools.git"
    },
    "keywords": [],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/postalsys/email-ai-tools/issues"
    },
    "homepage": "https://github.com/postalsys/email-ai-tools#readme",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "mailparser": "3.9.47",
        "prettier": "3.9.10"
    },
    "dependencies": {
        "@postalsys/email-text-tools": "2.5.0",
        "dom-serializer": "2.0.0",
        "domutils": "3.2.2",
        "htmlparser2": "10.1.0",
        "libmime": "5.5.2",
        "tldts": "7.4.18",
        "undici": "7.30.1"
    },
    "overrides": {
        "@asamuzakjp/css-color": "4.1.1"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
