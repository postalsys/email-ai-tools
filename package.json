{
    "name": "@postalsys/email-ai-tools",
    "version": "2.3.2",
    "description": "Summarize and risk-score email messages with an OpenAI-compatible chat model",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/lib/*"
            ],
            "index": [
                "dist/cjs/index.d.ts"
            ],
            "index.js": [
                "dist/cjs/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./index": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./index.js": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/lib/*.js",
            "require": "./dist/cjs/lib/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/lib/*.js",
            "require": "./dist/cjs/lib/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "node scripts/build.js --generate-only && tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --test test/*.test.cjs test/package/*.test.cjs test/package/*.test.mjs",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --test test/*.test.cjs test/package/*.test.cjs test/package/*.test.mjs",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node --test test/*.test.cjs test/package/*.test.cjs",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/email-ai-tools.git"
    },
    "keywords": [],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/postalsys/email-ai-tools/issues"
    },
    "homepage": "https://github.com/postalsys/email-ai-tools#readme",
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "mailparser": "3.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "dependencies": {
        "@postalsys/email-text-tools": "2.6.1",
        "dom-serializer": "2.0.0",
        "domutils": "3.2.2",
        "htmlparser2": "10.1.0",
        "libmime": "5.6.3",
        "tldts": "7.4.19",
        "undici": "7.30.1"
    },
    "overrides": {
        "@asamuzakjp/css-color": "4.1.1"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
